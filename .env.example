# Copia este archivo como .env (cp .env.example .env) y completa los valores.
# .env está en .gitignore: nunca se versiona.

# App ID de Open Exchange Rates (https://openexchangerates.org/signup/free).
# Se obtiene en https://openexchangerates.org/account/app-ids
# El plan gratuito permite ~1000 solicitudes/mes y la base es siempre USD.
OXR_APP_ID=

# Opcional: segundos de espera máxima por solicitud HTTP (por defecto 10).
# OXR_TIMEOUT=10
